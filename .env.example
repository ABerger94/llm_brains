# Persistent memory backend (app/api/memory). Optional for local dev — the
# app falls back to an in-memory store without these, but that fallback does
# NOT persist across serverless invocations in production. See README.md
# "One-time setup: connect a Redis database".
#
# Populated automatically when you connect an Upstash for Redis integration
# to this project via the Vercel dashboard's Storage tab; for local dev, run
# `vercel env pull .env.local` or fill these in by hand.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternative names accepted if you're wiring up Upstash directly instead of
# through Vercel's integration (lib/server/memoryDb.ts checks both).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
