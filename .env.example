# --- Local LLM only (LM Studio) — no cloud LLM keys ---
# LM Studio: Local Server tab → Start Server (default http://127.0.0.1:1234)
# If the server requires auth, create a token in Developer → Server; the backend sends:
#   Authorization: Bearer <LM_API_TOKEN>
LM_API_TOKEN=
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234
# Exact model id from LM Studio’s Local Server panel (example below).
LOCAL_LLM_MODELS=neuraldaredevil-8b-obliterated
# Slow / older PC: smaller prompts + lower default max_tokens when unset (set 1, true, or yes).
LOCAL_LLM_LOW_SPEC=1
# Max wait per LLM HTTP call (single module hop). If unset, defaults are ~480s (LOW_SPEC) or ~900s — see server/llmEnv.js.
# Range 10_000–7_200_000 ms. Set to your slowest expected module (long runs × many modules need headroom in scheduled-task stale threshold in Settings).
# LOCAL_LLM_TIMEOUT_MS=1800000
# Soft deadline (local streaming): return partial output and continue the pipeline instead of hard-failing (see server/index.js).
# Unset: hardTimeout − LOCAL_LLM_SOFT_BUFFER_MS (default 120s buffer). Override absolute: must be < hard timeout.
# LOCAL_LLM_SOFT_TIMEOUT_MS=
# LOCAL_LLM_SOFT_BUFFER_MS=120000
# Local-only: abort if no streaming chunk for this long (default 120s, 180s with LOW_SPEC). 0 = disable stall detection.
# LOCAL_LLM_STALL_MS=120000
# Tighter cap on prior-module text in the next prompt (chars). Default 7200 with LOW_SPEC, else 14000.
# LOCAL_LLM_CONTEXT_BUDGET_CHARS=6000
# Legacy: shrink moduleOutputs in RAM before each LLM call (default off). Prefer raising n_ctx / LLM_CONTEXT_TOKENS_MAX.
# LOCAL_LLM_COMPRESS_SHARED_MEMORY=0

# Per-request context budget (prompt + max_tokens + slack). Must not exceed LM Studio “Context Length” / n_ctx.
# Default if unset: 8190. Consciousness-stream modules (e.g. Learning reduce) often exceed 4k-equivalent prompts;
# prefer loading models at n_ctx ≥8192 and LLM_CONTEXT_TOKENS_MAX=8190 (or n_ctx−64ish). With n_ctx=4096 only,
# expect shrink/overflow; use LOCAL_LLM_COMPRESS_SHARED_MEMORY=1 and/or shorter runs, or a smaller pipeline.
# The app defaults to pipeline max_tokens 800 and 2 metacognition reruns (Settings); raise tokens/reruns only if n_ctx is large.
# LLM_CONTEXT_TOKENS_MAX=8190
# LLM_CONTEXT_SLACK_TOKENS=24
# Conservative token estimate: ceil(chars / N). Default 3.
# LLM_TOKEN_CHARS_PER_TOKEN=3
# auto | on | off — when over budget, pipeline modules use map→merge→reduce instead of one giant prompt.
# LLM_CHUNKED_MODULE_CALLS=auto
# Cap each module's `module_complete` SSE payload (default 12000). Stops very large Perception outputs from stalling the dev proxy / TCP before the next module starts.
# SSE_MODULE_COMPLETE_MAX_CHARS=12000
# Optional legacy alias for the same Bearer value (used only if LM_API_TOKEN is unset).
# LOCAL_LLM_API_KEY=lm-studio
#
# --- Optional: Ollama instead (same OpenAI-compatible /v1 API) ---
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODELS=llama3.2
# LOCAL_LLM_API_KEY=ollama

# --- Optional: Hugging Face Inference router (OpenAI-compatible; InferenceClient-style :provider suffix) ---
# Token: https://huggingface.co/settings/tokens (Read / Inference).
# IMPORTANT: Only models that show an Inference Provider on their HF model page work on the router.
# dphn/Dolphin3.0-R1-Mistral-24B currently has NO inference deployment — the router returns 400 / “does not exist”.
# Default dev model (Featherless on HF router; same shape as OpenAI client model=...:featherless-ai):
# HF_INFERENCE_MODELS=huihui-ai/Mistral-Small-24B-Instruct-2501-abliterated:featherless-ai
# Comma-separated fallbacks are supported if the first model is unavailable.
# HF_TOKEN=hf_xxxxxxxx
# HUGGINGFACE_API_TOKEN=   # alias for HF_TOKEN
# HF_INFERENCE_BASE_URL=https://router.huggingface.co
# --- Fast LLM route (`llmRoute: "fast"` on POST /api/llm/text, unified early bundle) ---
# `HF_INFERENCE_MODELS` = default/quality pipeline hops; `LLM_FAST_HF_MODEL` = small HF router model used ONLY for the fast path (comma fallbacks allowed).
# LLM_FAST_HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:featherless-ai
# If a fast call fails, fall back to the full provider list (1/true/yes); unset = warn and use default list when HF fast tier is missing.
# LLM_FAST_FALLBACK_TO_DEFAULT=0
#
# Force pipeline topology for all runs (overrides per-request options): `unified` | `classic`
# PIPELINE_PROFILE=unified
# Gating: `default` | `aggressive` | `off` (or set from Settings)
# PIPELINE_GATING=default
#
# --- Pipeline attachments: GLM-OCR (Z.ai via HF Inference Providers) ---
# Runs before the cognitive pipeline; image bytes are held in memory until the attachment TTL (see server).
# Uses the same HF token as the router. Model: https://huggingface.co/zai-org/GLM-OCR
# GLM_OCR_MODEL=zai-org/GLM-OCR
# GLM_OCR_PROVIDER=zai-org
# GLM_OCR_MAX_CHARS=48000
# GLM_OCR_TIMEOUT_MS=180000
# GLM_OCR_CONCURRENCY=2
# GLM_OCR_DISABLED=1
#
# --- Optional: OpenRouter (middle hop when HF + local are also configured) ---
# dolphin3.0-r1-mistral-24b is often absent from OpenRouter’s catalog (404). Defaults use models that exist in /api/v1/models.
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=cognitivecomputations/dolphin-mistral-24b-venice-edition:free,mistralai/mistral-small-24b-instruct-2501
# OPENROUTER_HTTP_REFERER=https://github.com/your/repo   # recommended by OpenRouter
# OPENROUTER_APP_TITLE=MetaSelf-CognitiveStack
#
# Dev UI: open http://localhost:3000 — Vite proxies /api to the backend (see package.json). Optional: VITE_DEV_PORT=3000
# Hot reload is OFF by default (HMR over Tailscale/LAN often full-reloads the page and kills pipelines). Set VITE_ENABLE_HMR=1 to enable.
# Legacy: VITE_DISABLE_HMR=1 still forces HMR off if you had that set.
# Even with HMR off, saving files under src/ triggers a full browser reload. vite.config.js ignores `server/` (nodemon),
# debounces writes (awaitWriteFinish), and skips .git/dist so unrelated churn does not reload the tab. For long runs with
# zero dev reloads, use a production build: npm run build && npm run preview (serves dist/; no file watcher).
# Provider order: default `npm run dev` sets LLM_HF_FIRST=1 (Hugging Face router). Use LLM_LOCAL_FIRST=1 with `npm run dev:local` for LM Studio–first.
# OpenRouter sits between local and HF in the chain. Omit tiers you do not configure.
#
# For Dolphin 3.0 R1 24B specifically: run locally (LM Studio GGUF / Ollama) or use a host that actually lists the model.

# --- Embedding service (probabilistic similarity — replaces lexical Jaccard) ---
# Model for /v1/embeddings calls. Must be supported by your provider (HF, LM Studio, Ollama).
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Base URL for embedding API (defaults to same provider as LLM chat).
# Optional: LRU for repeated query-similarity rows (epistemic fusion / stance vs labels). 0 = disable layer.
# SIMILARITY_QUERY_CACHE_SIZE=256

# On router.huggingface.co the server uses HF feature-extraction (not OpenAI /v1/embeddings — that path 404s).
# EMBEDDING_BASE_URL=
# Provider for HF feature-extraction when using the HF router (default: auto).
# EMBEDDING_HF_PROVIDER=auto
# API key for embedding endpoint (defaults to same as LLM provider key).
# EMBEDDING_API_KEY=
# In-memory LRU cache size (entries). 0 = no cache.
# EMBEDDING_CACHE_SIZE=512
# Set to 1 to disable embeddings and fall back to lexical Jaccard everywhere.
# EMBEDDING_DISABLED=0

# --- Adaptive temperature (probabilistic — temperature from interoception state) ---
# Set to 1 to disable adaptive temperature and use fixed client-supplied temperature.
# ADAPTIVE_TEMPERATURE_DISABLED=0
# Comma-separated pipeline module names: cap adaptive temperature at ADAPTIVE_TEMP_CRITICAL_CAP (default 0.45).
# ADAPTIVE_TEMP_CRITICAL_MODULES=
# ADAPTIVE_TEMP_CRITICAL_CAP=0.45
# When strictGlobalWorkspaceBroadcast, clamp Language/Narrative/Voice adaptive temp to this max (optional).
# STRICT_WORKSPACE_ADAPTIVE_MAX_TEMP=
# Optional: if Integration leaves salience empty, copy WORKING_MEMORY item text into globalWorkspace.salience (server).
# WORKSPACE_SALIENCE_BACKFILL=0

# --- Probabilistic memory retrieval (semantic vs recency blend + score gates) ---
# Base semantic weight in [0,1]; default 0.7 matches legacy fixed blend. Bounds clamp heuristics.
# RETRIEVAL_SEMANTIC_WEIGHT_BASE=0.7
# RETRIEVAL_SEMANTIC_WEIGHT_MIN=0.15
# RETRIEVAL_SEMANTIC_WEIGHT_MAX=0.95
# Recency decay exp(-ageDays * rate); default 0.02 matches prior behavior.
# RETRIEVAL_RECENCY_DECAY_PER_DAY=0.02
# Min-score floor + margin filtering is ON by default (still keeps top RETRIEVAL_FLOOR_MIN_KEEP items).
# RETRIEVAL_MIN_SCORE_DISABLED=0
# Or: RETRIEVAL_MIN_SCORE_ENABLED=0
# RETRIEVAL_SCORE_FLOOR_BASE=0.22
# RETRIEVAL_FLOOR_MIN_KEEP=3
# Log resolved alpha/floor/margin to console (debug).
# RETRIEVAL_POLICY_DEBUG=0

# --- Soft metacognition (probabilistic rerun threshold) ---
# Baseline threshold for RERUN confidence (0-1). Model must exceed this to trigger rerun.
# Actual threshold adapts based on uncertainty/entropy. Default 0.5.
# METACOGNITION_RERUN_THRESHOLD=0.5

# --- Multi-sample modules (probabilistic — run critical modules twice and merge) ---
# Set to 1 to enable multi-sample for Integration and/or Contradiction Engine.
# PIPELINE_INTEGRATION_MULTI_SAMPLE=0
# PIPELINE_CONTRADICTION_MULTI_SAMPLE=0
# Merge mode for multi-sample: 'llm' (third LLM call merges) or 'mechanical' (heuristic merge).
# PIPELINE_MULTI_SAMPLE_MERGE=llm

# --- Stochastic cognitive policy (probabilistic — policy sampling instead of lookup table) ---
# Set to 1 to disable stochastic policy and use the original deterministic lookup table.
# STOCHASTIC_POLICY_DISABLED=0

# --- Calibration & telemetry (probabilistic — adaptive thresholds from pipeline data) ---
# Path to calibrated thresholds JSON file. Stores learned overrides for all decision thresholds.
# CALIBRATED_THRESHOLDS_PATH=.data/calibrated-thresholds.json
# Path to pipeline telemetry log. Each run appends a line of metrics for recalibration.
# PIPELINE_TELEMETRY_PATH=.data/pipeline-telemetry.jsonl

PORT=8787

# --- In-pipeline web fetch (optional) ---
# Only Planning, Reasoning, Belief Store, Metacognition, Curiosity may end output with WEB_REQUEST (see WEB_HOOK_MODULES):
# KIND: SEARCH + TARGET: <query> uses Brave Search API; KIND: URL + TARGET: <https...> fetches a public page (SSRF-guarded).
# BRAVE_SEARCH_API_KEY=
# WEB_FETCH_DISABLED=0
# WEB_FETCH_MAX_PER_RUN=4
# WEB_FETCH_TIMEOUT_MS=12000
# WEB_FETCH_MAX_BYTES=500000
# WEB_CONTEXT_MAX_ENTRY_CHARS=8000
# Subset only — server ignores any name not in: Planning, Reasoning, Belief Store, Metacognition, Curiosity
# WEB_HOOK_MODULES=Planning,Reasoning,Belief Store,Metacognition,Curiosity

# --- Mind snapshot sync (optional — share one backup between laptop + phone browsers) ---
# Set a long random secret; clients send Authorization: Bearer <token>. Files under MIND_SNAPSHOT_DATA_DIR/mind-snapshot/
# MIND_SNAPSHOT_SYNC_TOKEN=
# Optional override (default: repo-root .data/)
# MIND_SNAPSHOT_DATA_DIR=.data
# Max PUT body for mind snapshot (Express raw parser). If nginx/Caddy fronts Node, set client_max_body_size / upload limit ≥ this.
# MIND_SNAPSHOT_UPLOAD_LIMIT=1gb

# --- iPhone / LAN / Tailscale (optional) ---
# Set to the SAME host you type in the browser (LAN IP, or PC’s `tailscale ip -4`, or *.ts.net name) so Vite HMR works.
# LM Studio and LM_API_TOKEN stay on this machine. Full checklist: TAILSCALE-IPHONE.md — run: npm run check:tailscale
# Allow Windows Firewall inbound TCP 5174 (all profiles). See TAILSCALE-IPHONE.md for ACLs, Serve, and iOS tips.
# DEV_LAN_HOST=192.168.1.10
#
# Optional extra UI origins (comma-separated). The server already allows http/https on ports 5174, 3000, 3001 for
# localhost, Tailscale (100.x, *.ts.net), and typical LAN private IPs — use this only for odd hosts or ports.
# CORS_ORIGINS=http://example:5174
